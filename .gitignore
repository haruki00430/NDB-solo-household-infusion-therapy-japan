02_Data/processed/
*.csv
*.xlsx
*.parquet
*.sqlite
*.db

*.log
05_Outputs/figures/
05_Outputs/reports/

.DS_Store
Thumbs.db
desktop.ini

.git.disabled_*/
**/.git.nested_repo_backup/
.serena/
.env.temp
nul

